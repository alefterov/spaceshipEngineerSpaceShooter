<?xml version="1.0" encoding="utf-8"?>
<!--
Declares the advertising ID permission explicitly. Google Play requires it for apps that declare ad ID use (AdMob ads):
without it, on Android 13+ the advertising ID is replaced with zeros. Merged into the app's manifest at build time.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.cyberforgestudio.adidpermission">
  <uses-permission android:name="com.google.android.gms.permission.AD_ID"/>
</manifest>
