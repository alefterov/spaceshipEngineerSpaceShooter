  - m_Id: 14404501504
    m_Localized: VICTOIRE !
    m_Metadata:
      m_Items: []
  - m_Id: 14404501505
    m_Localized: "D\xC9FAITE !"
    m_Metadata:
      m_Items: []
  - m_Id: 14404501506
    m_Localized: Chargement...
    m_Metadata:
      m_Items: []
  - m_Id: 14404501507
    m_Localized: "Un cockpit est n\xE9cessaire pour enregistrer le vaisseau"
    m_Metadata:
      m_Items: []
  - m_Id: 14404501508
    m_Localized: "Tous les blocs doivent \xEAtre reli\xE9s au cockpit"
    m_Metadata:
      m_Items: []
  - m_Id: 14404501509
    m_Localized: Ressources insuffisantes
    m_Metadata:
      m_Items: []
  - m_Id: 14404501510
    m_Localized: "Pas assez de pi\xE8ces"
    m_Metadata:
      m_Items: []
  - m_Id: 14408695808
    m_Localized: Achat en attente de confirmation
    m_Metadata:
      m_Items: []
  - m_Id: 14408695809
    m_Localized: "Achat effectu\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 14408695810
    m_Localized: "Achats restaur\xE9s"
    m_Metadata:
      m_Items: []
  - m_Id: 14408695811
    m_Localized: "L'achat a \xE9chou\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 14408695812
    m_Localized: La boutique est actuellement indisponible
    m_Metadata:
      m_Items: []
  - m_Id: 14408695813
    m_Localized: "Bienvenue \xE0 bord, commandant ! Votre vaisseau est presque pr\xEAt
      pour son premier combat, mais il lui manque encore un canon. Touchez \xAB Construire
      \xBB pour ouvrir le chantier naval."
    m_Metadata:
      m_Items: []
  - m_Id: 14408695814
    m_Localized: "Les blocs sont class\xE9s par cat\xE9gories. Touchez \xAB Armes
      \xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 14408695815
    m_Localized: Faites glisser le canon sur l'emplacement libre de votre vaisseau.
    m_Metadata:
      m_Items: []
  - m_Id: 14408695816
    m_Localized: Touchez la coche pour confirmer la construction.
    m_Metadata:
      m_Items: []
  - m_Id: 14408695817
    m_Localized: "Bien jou\xE9 ! Touchez \xAB Enregistrer \xBB pour garder votre
      nouveau vaisseau."
    m_Metadata:
      m_Items: []
  - m_Id: 14408695818
    m_Localized: "Votre vaisseau est enregistr\xE9. Quittez maintenant le chantier
      naval."
    m_Metadata:
      m_Items: []
  - m_Id: 14408695819
    m_Localized: "Votre vaisseau est pr\xEAt au combat. Touchez \xAB Jouer \xBB !"
    m_Metadata:
      m_Items: []
  - m_Id: 14408695820
    m_Localized: "Choisissez \xAB Campagne \xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 14408695821
    m_Localized: "S\xE9lectionnez le premier syst\xE8me stellaire."
    m_Metadata:
      m_Items: []
  - m_Id: 14408695822
    m_Localized: Touchez le niveau 1.
    m_Metadata:
      m_Items: []
  - m_Id: 14408695823
    m_Localized: "Touchez \xAB Jouer \xBB pour lancer le combat !"
    m_Metadata:
      m_Items: []
  - m_Id: 14408695824
    m_Localized: "Vous avez accompli une t\xE2che ! Ouvrez \xAB R\xE9compenses \xBB
      pour r\xE9cup\xE9rer votre prix."
    m_Metadata:
      m_Items: []
  - m_Id: 14408695825
    m_Localized: "Touchez \xAB R\xE9cup\xE9rer \xBB pour obtenir votre r\xE9compense."
    m_Metadata:
      m_Items: []
  - m_Id: 14408695826
    m_Localized: "Vous avez assez de points de recherche pour d\xE9bloquer les boucliers
      ! Ouvrez \xAB Recherche \xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 14408695827
    m_Localized: "Touchez le bouclier pour le rechercher. Les boucliers arr\xEAtent
      les tirs ennemis avant qu'ils ne touchent votre vaisseau."
    m_Metadata:
      m_Items: []
  - m_Id: 14408695828
    m_Localized: "D\xE9placez votre doigt sur le joystick pour piloter votre vaisseau.
      Vos canons tirent tout seuls : esquivez les tirs ennemis et d\xE9truisez tous
      les ennemis !"
    m_Metadata:
      m_Items: []
  references:
    version: 2
