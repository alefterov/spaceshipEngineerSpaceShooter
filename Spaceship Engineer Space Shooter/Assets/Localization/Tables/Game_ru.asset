    m_Metadata:
      m_Items: []
  - m_Id: 14400307202
    m_Localized: "\u0422\u0415\u0425\u041D\u041E\u041B\u041E\u0413\u0418\u0418"
    m_Metadata:
      m_Items: []
  - m_Id: 14400307203
    m_Localized: "\u041D\u0430\u0437\u0432\u0430\u043D\u0438\u0435 \u043A\u043E\u0440\u0430\u0431\u043B\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 14400307204
    m_Localized: "\u0412\u0432\u0435\u0434\u0438\u0442\u0435 \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 14400307205
    m_Localized: "\u0411\u0440\u043E\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 14400307206
    m_Localized: "\u041A\u043E\u043A\u043F\u0438\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 14400307207
    m_Localized: "\u0413\u0435\u043D\u0435\u0440\u0430\u0442\u043E\u0440 \u0438 \u044F\u0434\u0435\u0440\u043D\u044B\u0439
      \u0440\u0435\u0430\u043A\u0442\u043E\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 14400307208
    m_Localized: "\u0420\u0435\u0430\u043A\u0442\u0438\u0432\u043D\u044B\u0439 \u0438
      \u0438\u043E\u043D\u043D\u044B\u0439 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 14400307209
    m_Localized: "\u041A\u0438\u043D\u0435\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0435
      \u043E\u0440\u0443\u0436\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 14400307210
    m_Localized: "\u041B\u0430\u0437\u0435\u0440\u043D\u043E\u0435 \u043E\u0440\u0443\u0436\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 14400307211
    m_Localized: "\u0420\u0430\u043A\u0435\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 14400307212
    m_Localized: "\u041F\u043B\u0430\u0437\u043C\u0435\u043D\u043D\u043E\u0435 \u043E\u0440\u0443\u0436\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 14400307213
    m_Localized: "\u0420\u0435\u043C\u043E\u043D\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 14400307214
    m_Localized: "\u0429\u0438\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 14400307215
    m_Localized: "\u041E\u0431\u043E\u0440\u043E\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 14400307216
    m_Localized: "\u0414\u0432\u0438\u0433\u0430\u0442\u0435\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 14400307217
    m_Localized: "\u0413\u0435\u043D\u0435\u0440\u0430\u0442\u043E\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 14400307218
    m_Localized: "\u041C\u0435\u0442\u0435\u043E\u0440\u0438\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 14400307219
    m_Localized: "\u0414\u0432\u0438\u0436\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 14400307220
    m_Localized: "\u041E\u0440\u0443\u0436\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 14400307221
    m_Localized: "\u041E\u0440\u0443\u0436\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 14404501504
    m_Localized: "\u041F\u041E\u0411\u0415\u0414\u0410!"
    m_Metadata:
      m_Items: []
  - m_Id: 14404501505
    m_Localized: "\u041F\u041E\u0420\u0410\u0416\u0415\u041D\u0418\u0415!"
    m_Metadata:
      m_Items: []
  - m_Id: 14404501506
    m_Localized: "\u0417\u0430\u0433\u0440\u0443\u0437\u043A\u0430..."
    m_Metadata:
      m_Items: []
  - m_Id: 14404501507
    m_Localized: "\u041A\u043E\u043A\u043F\u0438\u0442 \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u0435\u043D
      \u0434\u043B\u044F \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u044F
      \u043A\u043E\u0440\u0430\u0431\u043B\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 14404501508
    m_Localized: "\u0412\u0441\u0435 \u0431\u043B\u043E\u043A\u0438 \u0434\u043E\u043B\u0436\u043D\u044B
      \u0431\u044B\u0442\u044C \u0441\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u044B
      \u0441 \u043A\u043E\u043A\u043F\u0438\u0442\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 14404501509
    m_Localized: "\u041D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E
      \u0440\u0435\u0441\u0443\u0440\u0441\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 14404501510
    m_Localized: "\u041D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E
      \u043C\u043E\u043D\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 14408695808
    m_Localized: "\u041F\u043E\u043A\u0443\u043F\u043A\u0430 \u043E\u0436\u0438\u0434\u0430\u0435\u0442
      \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 14408695809
    m_Localized: "\u041F\u043E\u043A\u0443\u043F\u043A\u0430 \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 14408695810
    m_Localized: "\u041F\u043E\u043A\u0443\u043F\u043A\u0438 \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 14408695811
    m_Localized: "\u041F\u043E\u043A\u0443\u043F\u043A\u0430 \u043D\u0435 \u0443\u0434\u0430\u043B\u0430\u0441\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 14408695812
    m_Localized: "\u041C\u0430\u0433\u0430\u0437\u0438\u043D \u0441\u0435\u0439\u0447\u0430\u0441
      \u043D\u0435\u0434\u043E\u0441\u0442\u0443\u043F\u0435\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 14408695813
    m_Localized: "\u0414\u043E\u0431\u0440\u043E \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C
      \u043D\u0430 \u0431\u043E\u0440\u0442, \u043A\u043E\u043C\u0430\u043D\u0434\u0438\u0440!
      \u0412\u0430\u0448 \u043A\u043E\u0440\u0430\u0431\u043B\u044C \u043F\u043E\u0447\u0442\u0438
      \u0433\u043E\u0442\u043E\u0432 \u043A \u043F\u0435\u0440\u0432\u043E\u043C\u0443
      \u0431\u043E\u044E, \u043D\u043E \u043D\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442
      \u043E\u0434\u043D\u043E\u0439 \u043F\u0443\u0448\u043A\u0438. \u041D\u0430\u0436\u043C\u0438\u0442\u0435
      \xAB\u0421\u0442\u0440\u043E\u0438\u0442\u044C\xBB, \u0447\u0442\u043E\u0431\u044B
      \u043E\u0442\u043A\u0440\u044B\u0442\u044C \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0442\u043E\u0440
      \u043A\u043E\u0440\u0430\u0431\u043B\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 14408695814
    m_Localized: "\u0411\u043B\u043E\u043A\u0438 \u0440\u0430\u0437\u0434\u0435\u043B\u0435\u043D\u044B
      \u043D\u0430 \u043A\u0430\u0442\u0435\u0433\u043E\u0440\u0438\u0438. \u041D\u0430\u0436\u043C\u0438\u0442\u0435
      \xAB\u041E\u0440\u0443\u0436\u0438\u0435\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 14408695815
    m_Localized: "\u041F\u0435\u0440\u0435\u0442\u0430\u0449\u0438\u0442\u0435 \u043F\u0443\u0448\u043A\u0443
      \u043D\u0430 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u043E\u0435 \u043C\u0435\u0441\u0442\u043E
      \u043A\u043E\u0440\u0430\u0431\u043B\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 14408695816
    m_Localized: "\u041D\u0430\u0436\u043C\u0438\u0442\u0435 \u043D\u0430 \u0433\u0430\u043B\u043E\u0447\u043A\u0443,
      \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u044C
      \u043F\u043E\u0441\u0442\u0440\u043E\u0439\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 14408695817
    m_Localized: "\u041E\u0442\u043B\u0438\u0447\u043D\u043E! \u041D\u0430\u0436\u043C\u0438\u0442\u0435
      \xAB\u0421\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C\xBB, \u0447\u0442\u043E\u0431\u044B
      \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C \u043D\u043E\u0432\u044B\u0439
      \u043A\u043E\u0440\u0430\u0431\u043B\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 14408695818
    m_Localized: "\u041A\u043E\u0440\u0430\u0431\u043B\u044C \u0441\u043E\u0445\u0440\u0430\u043D\u0451\u043D.
      \u0422\u0435\u043F\u0435\u0440\u044C \u0432\u044B\u0439\u0434\u0438\u0442\u0435
      \u0438\u0437 \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0442\u043E\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 14408695819
    m_Localized: "\u041A\u043E\u0440\u0430\u0431\u043B\u044C \u0433\u043E\u0442\u043E\u0432
      \u043A \u0431\u043E\u044E. \u041D\u0430\u0436\u043C\u0438\u0442\u0435 \xAB\u0418\u0433\u0440\u0430\u0442\u044C\xBB!"
    m_Metadata:
      m_Items: []
  - m_Id: 14408695820
    m_Localized: "\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \xAB\u041A\u0430\u043C\u043F\u0430\u043D\u0438\u044F\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 14408695821
    m_Localized: "\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u043F\u0435\u0440\u0432\u0443\u044E
      \u0437\u0432\u0451\u0437\u0434\u043D\u0443\u044E \u0441\u0438\u0441\u0442\u0435\u043C\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 14408695822
    m_Localized: "\u041D\u0430\u0436\u043C\u0438\u0442\u0435 \u043D\u0430 \u0443\u0440\u043E\u0432\u0435\u043D\u044C
      1."
    m_Metadata:
      m_Items: []
  - m_Id: 14408695823
    m_Localized: "\u041D\u0430\u0436\u043C\u0438\u0442\u0435 \xAB\u0418\u0433\u0440\u0430\u0442\u044C\xBB,
      \u0447\u0442\u043E\u0431\u044B \u043D\u0430\u0447\u0430\u0442\u044C \u0431\u043E\u0439!"
    m_Metadata:
      m_Items: []
  - m_Id: 14408695824
    m_Localized: "\u0412\u044B \u0432\u044B\u043F\u043E\u043B\u043D\u0438\u043B\u0438
      \u0437\u0430\u0434\u0430\u043D\u0438\u0435! \u041E\u0442\u043A\u0440\u043E\u0439\u0442\u0435
      \xAB\u041D\u0430\u0433\u0440\u0430\u0434\u044B\xBB, \u0447\u0442\u043E\u0431\u044B
      \u0437\u0430\u0431\u0440\u0430\u0442\u044C \u043F\u0440\u0438\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 14408695825
    m_Localized: "\u041D\u0430\u0436\u043C\u0438\u0442\u0435 \xAB\u0417\u0430\u0431\u0440\u0430\u0442\u044C\xBB,
      \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C
      \u043D\u0430\u0433\u0440\u0430\u0434\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 14408695826
    m_Localized: "\u0423 \u0432\u0430\u0441 \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E
      \u043E\u0447\u043A\u043E\u0432 \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0439,
      \u0447\u0442\u043E\u0431\u044B \u043E\u0442\u043A\u0440\u044B\u0442\u044C \u0449\u0438\u0442\u044B!
      \u041E\u0442\u043A\u0440\u043E\u0439\u0442\u0435 \xAB\u0418\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u044F\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 14408695827
    m_Localized: "\u041D\u0430\u0436\u043C\u0438\u0442\u0435 \u043D\u0430 \u0449\u0438\u0442,
      \u0447\u0442\u043E\u0431\u044B \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u044C
      \u0435\u0433\u043E. \u0429\u0438\u0442\u044B \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u044E\u0442
      \u0432\u0440\u0430\u0436\u0435\u0441\u043A\u0438\u0435 \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u044B
      \u0434\u043E \u0442\u043E\u0433\u043E, \u043A\u0430\u043A \u043E\u043D\u0438
      \u043F\u043E\u043F\u0430\u0434\u0443\u0442 \u0432 \u043A\u043E\u0440\u0430\u0431\u043B\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 14408695828
