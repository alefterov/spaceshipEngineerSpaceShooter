  - m_Id: 14404501504
    m_Localized: SIEG!
    m_Metadata:
      m_Items: []
  - m_Id: 14404501505
    m_Localized: NIEDERLAGE!
    m_Metadata:
      m_Items: []
  - m_Id: 14404501506
    m_Localized: Wird geladen...
    m_Metadata:
      m_Items: []
  - m_Id: 14404501507
    m_Localized: "Zum Speichern des Schiffs ist ein Cockpit n\xF6tig"
    m_Metadata:
      m_Items: []
  - m_Id: 14404501508
    m_Localized: "Alle Bl\xF6cke m\xFCssen mit dem Cockpit verbunden sein"
    m_Metadata:
      m_Items: []
  - m_Id: 14404501509
    m_Localized: Nicht genug Ressourcen
    m_Metadata:
      m_Items: []
  - m_Id: 14404501510
    m_Localized: "Nicht genug M\xFCnzen"
    m_Metadata:
      m_Items: []
  - m_Id: 14408695808
    m_Localized: "Kauf wartet auf Best\xE4tigung"
    m_Metadata:
      m_Items: []
  - m_Id: 14408695809
    m_Localized: Kauf abgeschlossen
    m_Metadata:
      m_Items: []
  - m_Id: 14408695810
    m_Localized: "K\xE4ufe wiederhergestellt"
    m_Metadata:
      m_Items: []
  - m_Id: 14408695811
    m_Localized: Kauf fehlgeschlagen
    m_Metadata:
      m_Items: []
  - m_Id: 14408695812
    m_Localized: "Der Shop ist derzeit nicht verf\xFCgbar"
    m_Metadata:
      m_Items: []
  - m_Id: 14408695813
    m_Localized: "Willkommen an Bord, Commander! Dein Schiff ist fast bereit f\xFCr
      seinen ersten Kampf, aber ein Gesch\xFCtz fehlt noch. Tippe auf \u201EBauen\u201C,
      um die Werft zu \xF6ffnen."
    m_Metadata:
      m_Items: []
  - m_Id: 14408695814
    m_Localized: "Bl\xF6cke sind nach Kategorien sortiert. Tippe auf \u201EWaffen\u201C."
    m_Metadata:
      m_Items: []
  - m_Id: 14408695815
    m_Localized: "Ziehe das Gesch\xFCtz auf den freien Platz deines Schiffs."
    m_Metadata:
      m_Items: []
  - m_Id: 14408695816
    m_Localized: "Tippe auf das H\xE4kchen, um den Bau zu best\xE4tigen."
    m_Metadata:
      m_Items: []
  - m_Id: 14408695817
    m_Localized: "Gut gemacht! Tippe auf \u201ESpeichern\u201C, um dein neues Schiff
      zu behalten."
    m_Metadata:
      m_Items: []
  - m_Id: 14408695818
    m_Localized: Dein Schiff ist gespeichert. Verlasse jetzt die Werft.
    m_Metadata:
      m_Items: []
  - m_Id: 14408695819
    m_Localized: "Dein Schiff ist kampfbereit. Tippe auf \u201ESpielen\u201C!"
    m_Metadata:
      m_Items: []
  - m_Id: 14408695820
    m_Localized: "W\xE4hle \u201EKampagne\u201C."
    m_Metadata:
      m_Items: []
  - m_Id: 14408695821
    m_Localized: "W\xE4hle das erste Sternensystem."
    m_Metadata:
      m_Items: []
  - m_Id: 14408695822
    m_Localized: Tippe auf Level 1.
    m_Metadata:
      m_Items: []
  - m_Id: 14408695823
    m_Localized: "Tippe auf \u201ESpielen\u201C, um den Kampf zu starten!"
    m_Metadata:
      m_Items: []
  - m_Id: 14408695824
    m_Localized: "Du hast eine Aufgabe erf\xFCllt! \xD6ffne \u201EBelohnungen\u201C,
      um deinen Preis abzuholen."
    m_Metadata:
      m_Items: []
  - m_Id: 14408695825
    m_Localized: "Tippe auf \u201EAbholen\u201C, um deine Belohnung zu erhalten."
    m_Metadata:
      m_Items: []
  - m_Id: 14408695826
    m_Localized: "Du hast genug Forschungspunkte, um Schilde freizuschalten! \xD6ffne
      \u201EForschung\u201C."
    m_Metadata:
      m_Items: []
  - m_Id: 14408695827
    m_Localized: "Tippe auf den Schild, um ihn zu erforschen. Schilde stoppen feindliche
      Sch\xFCsse, bevor sie dein Schiff treffen."
    m_Metadata:
      m_Items: []
  - m_Id: 14408695828
    m_Localized: "Bewege den Finger auf dem Joystick, um dein Schiff zu steuern.
      Deine Gesch\xFCtze feuern von selbst: Weiche feindlichen Sch\xFCssen aus und
      vernichte alle Gegner!"
    m_Metadata:
      m_Items: []
  references:
    version: 2
